# ===== Trình duyệt (công khai, tiền tố VITE_) =====
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Địa chỉ gốc công khai của ứng dụng (dùng cho nút chia sẻ và thẻ Open Graph)
VITE_SITE_URL=https://tro-ly-hoc-thuat.vercel.app

# ===== Máy chủ (bí mật, KHÔNG có tiền tố VITE_) =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
# Tùy chọn: đổi mô hình (mặc định claude-opus-5-5). Đổi sang claude-sonnet-5-5 để giảm chi phí.
ANTHROPIC_MODEL=claude-opus-5-5
# Email liên hệ gửi kèm khi gọi OpenAlex/Crossref ("polite pool")
CONTACT_EMAIL=you@example.com

# Bộ đếm truy cập lưu ngay trong Supabase (không cần Upstash/Redis); quốc gia lấy từ tiêu đề của Vercel.
# Tùy chọn: ghi đè bảng giá khi tính chi phí API (USD cho 1 triệu token), nếu không đặt thì dùng bảng giá niêm yết trong api/_lib/pricing.ts
# ANTHROPIC_PRICE_IN=4
# ANTHROPIC_PRICE_OUT=20
